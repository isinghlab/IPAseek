nextflow.enable.dsl = 2

// Include sub-configs
includeConfig 'conf/slurm.config'
includeConfig 'conf/resources.config'

// Pipeline parameters
params {
    samplesheet       = null
    genome            = 'hg38'
    star_index        = null
    intron_annotation = null
    annotation_dir    = null
    atlas_name        = 'ipaseek_atlas'
    outdir            = 'results'
    chromosomes       = [
        'chr1','chr2','chr3','chr4','chr5','chr6','chr7','chr8',
