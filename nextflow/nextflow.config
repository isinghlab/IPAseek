params {
    // ── Primary input (native IPAseek format) ──────────────────────────
    data_table         = null   // Path to IPAseek data_table.txt (TSV)

    // ── Alternative input (Nextflow CSV samplesheet) ───────────────────
    samplesheet        = null   // Path to CSV samplesheet

    // ── Required paths ─────────────────────────────────────────────────
    star_index         = System.getenv('IPASEEK_STAR_INDEX')    ?: null
    annotation_dir     = System.getenv('IPASEEK_ANNOTATION_DIR') ?: null
    intron_annotation  = "${projectDir}/../1_intron_preprocessing/3_filtering_gobj/rnhg38_filtered_introns_cds.rds"

    // ── Run settings ───────────────────────────────────────────────────
    genome             = 'hg38'
    atlas_name         = 'ipaseek_run'
    outdir             = 'results'
    slurm_account      = System.getenv('IPASEEK_SLURM_ACCOUNT') ?: ''
    chromosomes        = ['chr1','chr2','chr3','chr4','chr5','chr6','chr7',
                          'chr8','chr9','chr10','chr11','chr12','chr13','chr14',
                          'chr15','chr16','chr17','chr18','chr19','chr20',
                          'chr21','chr22','chrX','chrY']
}

profiles {
    slurm  { includeConfig 'conf/slurm.config'  }
    test   { includeConfig 'conf/test.config'   }
    conda  {
        conda.enabled    = true
        conda.createEnv  = true
    }
}
