/*
 * Test profile — uses bundled test data for smoke testing
 * Usage: nextflow run nextflow/main.nf -profile test,slurm
 */
params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Smoke test using bundled test_input data (chr22 only)'

    data_table        = "${projectDir}/../input_data_tables/data_table_test.txt"
    atlas_name        = 'test_run'
    outdir            = 'test_results'
    chromosomes       = ['chr22']  // one chromosome only for speed
}
