// SLURM executor configuration
// Account is read automatically from IPASEEK_SLURM_ACCOUNT env var (set by setup.sh)
// Override at runtime with: --slurm_account YOUR_ACCOUNT
process {
    executor       = 'slurm'
    clusterOptions = { params.slurm_account ? "--account=${params.slurm_account}" : '' }
    queue          = 'normal'
}
