process {
    executor       = 'slurm'
    // Account is read from IPASEEK_SLURM_ACCOUNT env var (set by setup.sh)
    // or can be overridden with --slurm_account on the command line
    clusterOptions = { params.slurm_account ? "--account=${params.slurm_account}" : "" }
    queue          = 'normal'
}
